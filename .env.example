# CyberX environment variables — copy to `.env` (which is gitignored) and fill in.
# The Express backend loads this via `dotenv/config` (see src/server/index.ts).

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
# Python Flask RL API the /api/rl proxy forwards to
RL_API_URL=http://localhost:5001

# Comma-separated CORS allowlist (frontend origins). Defaults to the local dev
# origins if unset. Set this to your real site origin in production.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Optional API key. If set, every /api/* request must send a matching
# `X-API-Key` header. Leave unset for open local dev; SET IT before exposing
# the backend to anyone else.
# CYBERX_API_KEY=change-me

# ── Security posture ──────────────────────────────────────────────────────────
# Allow scanners to fetch private/loopback/link-local targets (SSRF guard off).
# Leave UNSET on any instance reachable by others; set to 1 only in a trusted
# local lab (e.g. to scan your own localhost app or honeypot).
# CYBERX_ALLOW_PRIVATE_TARGETS=1

# ── Third-party API keys (optional; enable individual OSINT/threat-intel tools) ─
# HUNTER_API_KEY=
# VT_API_KEY=
# ABUSEIPDB_API_KEY=
# NUMVERIFY_API_KEY=

# ── Frontend (Vite) — set at build time, not here ─────────────────────────────
# VITE_API_BASE_URL=http://localhost:5000
