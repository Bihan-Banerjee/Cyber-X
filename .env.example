# CyberX environment variables. Copy to .env and fill in as needed.
# .env is gitignored. All values below are optional; sensible defaults apply.

# ── Backend (Express, src/server) ──────────────────────────────────────────────

# Port the Express API listens on.
PORT=5000

# URL of the Python RL Flask API (proxied at /api/rl/*). Only needed if you run
# the RL stack in src/server/rl.
RL_API_URL=http://localhost:5001

# CORS for the API.
#   - Leave UNSET (the default) to reflect ANY origin. A deployed frontend on any
#     host (Vercel, Render, a preview URL, ...) then works with no extra config.
#     The API is unauthenticated by default, so CORS is not the real security
#     boundary here; set CYBERX_API_KEY below to actually lock it down.
#   - Set a comma-separated allowlist of exact origins to restrict it. A trailing
#     slash is tolerated, so "https://x/" and "https://x" both match.
#   - Set * to allow any origin explicitly.
# CORS_ORIGINS=https://your-frontend.example.com,https://your-frontend.vercel.app
# CORS_ORIGINS=*

# Optional API-key gate. If set, every /api/* request (except /health) must send
# a matching X-API-Key header. Unset = open (fine for local dev).
# CYBERX_API_KEY=choose-a-long-random-string

# Scan rate limiter (defaults: 20 requests per 15 minutes on /api/scan).
# SCAN_RATE_MAX=20
# SCAN_RATE_WINDOW_MS=900000

# SSRF guard: leave unset in production. Set to 1 ONLY in a trusted lab to allow
# scanners to reach private/loopback addresses (e.g. testing your own honeypot).
# CYBERX_ALLOW_PRIVATE_TARGETS=

# ── Optional third-party API keys (tools work without them, with reduced data) ──

# IP Reputation Checker (AbuseIPDB)
# ABUSEIPDB_API_KEY=

# Domain Reputation and Malware Hash Lookup (VirusTotal)
# VT_API_KEY=

# Phone OSINT carrier lookup (NumVerify)
# NUMVERIFY_API_KEY=

# Company OSINT email discovery (Hunter.io)
# HUNTER_API_KEY=

# ── Frontend (Vite, build-time) ────────────────────────────────────────────────

# Base URL the frontend calls for the API. Defaults to http://localhost:5000.
# In production set this to your deployed backend URL before building.
# VITE_API_BASE_URL=https://your-backend.example.com
